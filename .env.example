# Neon PostgreSQL Database Connection String
# Get yours from https://console.neon.tech
# Use the -pooler host. Don't add pgbouncer=true: Neon's pooler supports prepared statements,
# and that flag makes every query 2-3x slower (extra round trips).
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-cool-name-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=10&connection_limit=10&pool_timeout=10"

# Direct URL (no -pooler) — Prisma uses it for schema changes (npm run db:push)
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=10"

# Auth.js secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it signs everyone out.
AUTH_SECRET="generate-a-strong-random-secret-here"

# Base URL — change to your production URL on deploy
NEXTAUTH_URL="http://localhost:3000"
