# Neon PostgreSQL Database Connection String
# Get yours from https://console.neon.tech
# Use the -pooler host. Don't add pgbouncer=true: Neon's pooler supports prepared statements,
# and that flag makes every query 2-3x slower (extra round trips).
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-cool-name-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=10&connection_limit=10&pool_timeout=10"

# Direct URL (no -pooler) — Prisma uses it for schema changes (npm run db:push)
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=10"

# Auth.js secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it signs everyone out.
AUTH_SECRET="generate-a-strong-random-secret-here"

# Base URL — change to your production URL on deploy
NEXTAUTH_URL="https://priinteve-admin-panel.vercel.app"

# ---------------------------------------------------------------------------
# Morning Companion (desktop briefing app) — all optional. See docs/COMPANION.md.
# ---------------------------------------------------------------------------

# Public URL of the panel (OAuth redirects and links in the briefing). No trailing slash.
APP_URL="https://priinteve-admin-panel.vercel.app"

# Encrypts stored Gmail tokens. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Don't change it once accounts are connected (they'd all need reconnecting).
COMPANION_ENCRYPTION_KEY=""

# Slack bot token (xoxb-...) with channels:history (+ groups:history for private channels).
SLACK_BOT_TOKEN=""

# Google OAuth client (Gmail API, scope gmail.readonly).
# Redirect URI: <APP_URL>/api/companion/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Development only: let website checks reach localhost/LAN addresses. Ignored in production.
# COMPANION_ALLOW_PRIVATE_URLS="true"

# ---------------------------------------------------------------------------
# File storage: AWS S3 (task attachments, companion installer). See docs/STORAGE.md.
# On Vercel use these S3_* names (Vercel reserves AWS_*). Locally AWS_REGION /
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY also work.
# ---------------------------------------------------------------------------
S3_BUCKET=""
S3_REGION="ap-south-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# S3_KEY_PREFIX="admin-panel"
